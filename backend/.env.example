# ── Application Environment ──
# Options: development | staging | production
ENV=development
DEBUG=True
APP_NAME="Annotation Quality Guardian"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── Database (PostgreSQL) ──
# Example for local PostgreSQL: postgresql://postgres:postgres@localhost:5432/aqg_db
# Fallback / SQLite example: sqlite:///./aqg.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqg_db

# ── Redis Cache / Task Queue (Optional) ──
REDIS_URL=redis://localhost:6379/0

# ── CORS Origins (Comma-separated) ──
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
