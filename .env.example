# ==============================================================================
# Annotation Quality Guardian (AQG) — Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# ── Application Environment ──
ENV=production
DEBUG=False
APP_NAME="Annotation Quality Guardian"

# ── Security & Authentication ──
# IMPORTANT: Generate a strong secret in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── PostgreSQL Database ──
POSTGRES_DB=aqg_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Redis Cache & Celery Message Broker ──
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ── Server Ports ──
BACKEND_PORT=8000
FRONTEND_PORT=80

# ── Frontend API Routing ──
# When using Nginx reverse proxy in production, leave empty or point to /api
VITE_API_URL=""

# ── CORS Origins (comma-separated) ──
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# ── Demo Seeding ──
# Set to 'true' to automatically seed initial demo users and projects on first run
SEED_DEMO_DATA=true
